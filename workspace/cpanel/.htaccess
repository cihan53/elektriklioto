# ==============================================================================
# elektriklioto.com - cPanel Apache .htaccess
# ==============================================================================

AddDefaultCharset UTF-8

# Varsayılan açılış sayfası olarak index.html'i önceliklendir (WordPress index.php kalıntılarını ezer)
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. HTTP -> HTTPS Yönlendirmesi
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Backend Fastify API Reverse Proxy (Port 4000)
    # /api/ isteklerini arka planda çalışan Fastify API'ye yönlendir
    RewriteRule ^api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L]
    RewriteRule ^api$ http://127.0.0.1:4000/api/ [P,L]

    # Swagger API Dokümantasyonu Yönlendirmesi
    RewriteRule ^documentation/(.*)$ http://127.0.0.1:4000/documentation/$1 [P,L]
    RewriteRule ^documentation$ http://127.0.0.1:4000/documentation/ [P,L]

    # 3. Gerçek Dosya veya Dizin Varsa Doğrudan Sun
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. SPA Fallback (index.html harici bulunamayan istekleri index.html'e yönlendir)
    RewriteCond %{REQUEST_URI} !^/index\.html$
    RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# 5. Statik Varlıklar İçin Tarayıcı Önbellekleme (Cache-Control)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. Gzip / Deflate Sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# 7. Temel Güvenlik Başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
