
{
  "openapi": "3.1.0",
  "info": {
    "title": "elektriklioto.com API",
    "description": "e-Mobilite asistanı — istasyon keşif ve harita API yüzeyi. Tarife/durum bilgisi amaçlıdır, bağlayıcı değildir; platform lisanslı bir şarj operatörü değildir.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://api.elektriklioto.com" }],
  "tags": [{ "name": "stations", "description": "İstasyon keşif ve harita uçları" }],
  "x-generated-by": "apps/api/scripts/generate-openapi.ts — elle düzenlenmez, CI'da yeniden üretilip diff alınır (US-I1/AC1)",
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Süreç canlı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "const": "ok" } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "DB bağlantısı hazır",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "const": "ready" } },
                  "required": ["status"]
                }
              }
            }
          },
          "503": {
            "description": "DB bağlantısı hazır değil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "const": "not_ready" } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stations": {
      "get": {
        "tags": ["stations"],
        "summary": "Viewport (bbox) içindeki istasyonları veya kümeleri listeler",
        "description": "US-A1: zoom < 10 için ST_SnapToGrid kümesi, aksi halde tekil istasyon pinleri döner. Tüm Türkiye tek seferde indirilmez — bbox alanı üst sınırı aşarsa 422 döner.",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "description": "Görünüm alanı: minLon,minLat,maxLon,maxLat (WGS84)",
            "schema": { "type": "string", "pattern": "^-?\\d{1,3}(?:\\.\\d+)?,-?\\d{1,3}(?:\\.\\d+)?,-?\\d{1,3}(?:\\.\\d+)?,-?\\d{1,3}(?:\\.\\d+)?$" }
          },
          {
            "name": "zoom",
            "in": "query",
            "required": true,
            "description": "Harita zoom seviyesi (0-22)",
            "schema": { "type": "integer", "minimum": 0, "maximum": 22 }
          },
          {
            "name": "power",
            "in": "query",
            "required": false,
            "description": "Virgülle ayrılmış güç bandı listesi (AC_22,DC_60,DC_120_PLUS)",
            "schema": { "type": "string" }
          },
          {
            "name": "socket",
            "in": "query",
            "required": false,
            "description": "Virgülle ayrılmış soket tipi listesi (CCS,CHAdeMO,Type2)",
            "schema": { "type": "string" }
          },
          {
            "name": "operator",
            "in": "query",
            "required": false,
            "description": "Virgülle ayrılmış operatör kimliği listesi",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Virgülle ayrılmış durum listesi (operational,faulted,unknown)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "İstasyon pinleri veya kümeleri",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["mode", "features"],
                  "properties": {
                    "mode": { "type": "string", "enum": ["pins", "clusters"] },
                    "features": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type", "stationUid", "name", "operatorId", "operatorName",
                              "facilityType", "lon", "lat", "socketTypes", "maxPowerKw",
                              "status", "lastSyncedAt"
                            ],
                            "properties": {
                              "type": { "type": "string", "const": "pin" },
                              "stationUid": { "type": "string" },
                              "name": { "type": "string" },
                              "operatorId": { "type": "string" },
                              "operatorName": { "type": "string" },
                              "facilityType": { "type": "string" },
                              "lon": { "type": "number" },
                              "lat": { "type": "number" },
                              "socketTypes": { "type": "array", "items": { "type": "string" } },
                              "maxPowerKw": { "type": "number" },
                              "status": { "type": "string" },
                              "lastSyncedAt": { "type": "string" }
                            }
                          },
                          {
                            "type": "object",
                            "required": ["type", "lon", "lat", "count"],
                            "properties": {
                              "type": { "type": "string", "const": "cluster" },
                              "lon": { "type": "number" },
                              "lat": { "type": "number" },
                              "count": { "type": "integer" }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz bbox",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "message"],
                  "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
                }
              }
            }
          },
          "422": {
            "description": "bbox alanı izin verilen üst sınırı aşıyor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error", "message"],
                  "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
