
{
  "name": "@elektriklioto/infra",
  "version": "1.0.0",
  "private": true,
  "description": "elektriklioto.com PostGIS Veritabanı ve Migration Altyapısı",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
