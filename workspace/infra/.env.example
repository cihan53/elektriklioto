
# --- PostgreSQL (docker-compose servisi için) ---
POSTGRES_USER=elektriklioto
POSTGRES_PASSWORD=elektriklioto_local_only
POSTGRES_DB=elektriklioto
POSTGRES_PORT=5432

# --- Uygulama ortam değişkenleri (packages/config zod şemasıyla doğrulanır) ---
# Şema dışı/eksik değişkenle api ve worker süreçleri BAŞLAMAZ.
NODE_ENV=development

DATABASE_URL=postgres://elektriklioto:elektriklioto_local_only@localhost:5432/elektriklioto

API_HOST=0.0.0.0
API_PORT=3000

WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3100

LOG_LEVEL=info

# Virgülle ayrılmış izinli origin listesi (yalnızca elektriklioto.com ve uygulama şemaları)
CORS_ORIGIN=https://elektriklioto.com,https://www.elektriklioto.com
