
# ==============================================================================
# elektriklioto.com - Bağımsız Asenkron Worker Üretim İmajı
# Sprint: S5 — Asenkron Worker Kuyruğu ve Veri Tazeliği
# ==============================================================================

# 1. Derleme Aşaması (Builder)
FROM node:22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json tsconfig.json ./
RUN npm ci

COPY src/ ./src/

RUN npm run build
RUN npm prune --omit=dev

# 2. Üretim Çalışma Zamanı (Headless Worker)
FROM node:22-alpine AS runner

WORKDIR /app

# Güvenlik: root yetkisi olmayan servis kullanıcısı
RUN addgroup -g 1001 -S workergroup && \
    adduser -S -u 1001 -G workergroup workeruser

ENV NODE_ENV=production \
    WORKER_POLL_INTERVAL_MS=1000 \
    CB_FAILURE_THRESHOLD=5 \
    CB_COOLDOWN_MS=900000 \
    HTTP_TIMEOUT_MS=5000

COPY --from=builder --chown=workeruser:workergroup /app/package.json ./package.json
COPY --from=builder --chown=workeruser:workergroup /app/node_modules ./node_modules
COPY --from=builder --chown=workeruser:workergroup /app/dist ./dist

USER workeruser

# Worker HTTP portu dinlemez, doğrudan PostgreSQL SKIP LOCKED kuyruğuna bağlanır
CMD ["node", "dist/worker.js"]
