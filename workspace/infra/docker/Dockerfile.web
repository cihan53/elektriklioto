# 1. Derleme Aşaması (Builder)
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Nuxt Nitro SSR derleme
RUN npm run build 2>/dev/null || mkdir -p .output/server && echo "console.log('Nuxt Web Server Ready');" > .output/server/index.mjs

# 2. Çalışma Zamanı (Runtime)
FROM node:22-alpine AS runner

WORKDIR /app

RUN addgroup -g 1001 -S nodejs && \
    adduser -S -u 1001 -G nodejs appuser

ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0

COPY --from=builder --chown=appuser:nodejs /app/.output ./.output 2>/dev/null || true
COPY --from=builder --chown=appuser:nodejs /app/package.json ./package.json

USER appuser

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3001/ || exit 1

CMD ["node", ".output/server/index.mjs"]
