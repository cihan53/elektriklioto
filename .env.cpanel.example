# ==============================================================================
# elektriklioto.com - cPanel Üretim Ortamı Değişkenleri (.env)
# ==============================================================================
# Bu dosyayı sunucuda ".env" adıyla kopyalayınız:
# cp .env.cpanel.example .env
# ==============================================================================

# Ortam ve Ağ Yapılandırması
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# cPanel Veritabanı Bağlantısı (PostgreSQL / MySQL)
# Örnek cPanel PostgreSQL: postgres://cpuser_dbuser:Sifre123!@localhost:5432/cpuser_elektriklioto
# Örnek cPanel MySQL: mysql://cpuser_dbuser:Sifre123!@localhost:3306/cpuser_elektriklioto
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elektriklioto

# Gizli Anahtarlar (Production için 32 karakter rastgele string giriniz)
PROXIMITY_SECRET=elektriklioto-prod-proximity-secret-change-me-32b!
ROUTE_BRIDGE_SECRET=elektriklioto-prod-bridge-secret-change-me-32b!

# Hız Sınırlandırmaları (Rate Limiting)
RATE_LIMIT_MAX=120
REPORT_RATE_LIMIT_MAX=5
REPORT_DEFECT_THRESHOLD=3
REPORT_WINDOW_MINUTES=120

# Worker ve Zamanlayıcı Ayarları
WORKER_POLL_INTERVAL_MS=1000
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=900000
HTTP_TIMEOUT_MS=5000
CPO_SYNC_INTERVAL_MINUTES=15
